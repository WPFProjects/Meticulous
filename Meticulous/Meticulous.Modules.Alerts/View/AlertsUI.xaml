<UserControl x:Class="Meticulous.Modules.Alerts.View.AlertsUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Meticulous.Modules.Alerts.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--========================================================-->
        <!-- Header -->
        <!--========================================================-->

        <Grid Grid.Row="0" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="Alerts"
                FontSize="24"
                VerticalAlignment="Center"/>

            <TextBlock
                Grid.Column="1"
                Margin="0,0,15,0"
                VerticalAlignment="Center"
                Text="Last Scan : 10:42 AM"/>

            <Button
                Grid.Column="2"
                Width="90"
                Height="30"
                Content="Refresh"/>

        </Grid>

        <!--========================================================-->
        <!-- Summary Cards -->
        <!--========================================================-->

        <UniformGrid
            Grid.Row="1"
            Columns="4"
            Margin="0,0,0,15">

            <Border Margin="5">
                <StackPanel Margin="10">
                    <TextBlock Text="Active Alerts"/>
                    <TextBlock Text="22" FontSize="22"/>
                </StackPanel>
            </Border>

            <Border Margin="5">
                <StackPanel Margin="10">
                    <TextBlock Text="Critical"/>
                    <TextBlock Text="8" FontSize="22"/>
                </StackPanel>
            </Border>

            <Border Margin="5">
                <StackPanel Margin="10">
                    <TextBlock Text="Warning"/>
                    <TextBlock Text="14" FontSize="22"/>
                </StackPanel>
            </Border>

            <Border Margin="5">
                <StackPanel Margin="10">
                    <TextBlock Text="Resolved Today"/>
                    <TextBlock Text="23" FontSize="22"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!--========================================================-->
        <!-- Filters -->
        <!--========================================================-->

        <Grid Grid.Row="2" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <ComboBox Margin="5">
                <ComboBoxItem Content="Severity"/>
            </ComboBox>

            <ComboBox Grid.Column="1" Margin="5">
                <ComboBoxItem Content="Status"/>
            </ComboBox>

            <ComboBox Grid.Column="2" Margin="5">
                <ComboBoxItem Content="Service"/>
            </ComboBox>

            <ComboBox Grid.Column="3" Margin="5">
                <ComboBoxItem Content="Owner"/>
            </ComboBox>

            <TextBox
                Grid.Column="5"
                Margin="5"
                Height="30"
                VerticalContentAlignment="Center"
                Text="Search"/>

        </Grid>

        <!--========================================================-->
        <!-- Main Content -->
        <!--========================================================-->

        <Grid Grid.Row="3">

            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--====================================================-->
            <!-- Alert List -->
            <!--====================================================-->

            <DataGrid
                Grid.Row="0"
                Margin="0,0,0,10"
                AutoGenerateColumns="False">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Severity"
                        Binding="{Binding Severity}"/>

                    <DataGridTextColumn
                        Header="Alert"
                        Binding="{Binding AlertName}"/>

                    <DataGridTextColumn
                        Header="Host"
                        Binding="{Binding Host}"/>

                    <DataGridTextColumn
                        Header="Time"
                        Binding="{Binding Time}"/>

                    <DataGridTextColumn
                        Header="Status"
                        Binding="{Binding Status}"/>

                    <DataGridTextColumn
                        Header="Owner"
                        Binding="{Binding Owner}"/>

                </DataGrid.Columns>

            </DataGrid>

            <!--====================================================-->
            <!-- Bottom Panels -->
            <!--====================================================-->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Alert Details -->

                <Border Grid.Column="0" Padding="10">

                    <StackPanel>

                        <TextBlock
                            Text="Alert Details"
                            FontSize="18"
                            Margin="0,0,0,10"/>

                        <TextBlock Text="Severity : Critical"/>
                        <TextBlock Text="Status : Active"/>
                        <TextBlock Text="Host : DB-Server-03"/>
                        <TextBlock Text="Service : Database"/>
                        <TextBlock Text="Owner : John"/>
                        <TextBlock Text="Created : 10:31 AM"/>
                        <TextBlock Text=""/>

                        <TextBlock
                            Text="Description"
                            FontWeight="Bold"/>

                        <TextBlock
                            TextWrapping="Wrap"
                            Margin="0,5,0,15"
                            Text="Database connection lost after storage timeout."/>

                        <WrapPanel>

                            <Button
                                Width="100"
                                Margin="0,0,10,0"
                                Content="Acknowledge"/>

                            <Button
                                Width="100"
                                Margin="0,0,10,0"
                                Content="Assign"/>

                            <Button
                                Width="100"
                                Content="Resolve"/>

                        </WrapPanel>

                    </StackPanel>

                </Border>

                <!-- Splitter -->

                <GridSplitter
                    Grid.Column="1"
                    Width="5"
                    HorizontalAlignment="Stretch"/>

                <!-- Timeline -->

                <Border
                    Grid.Column="2"
                    Padding="10"
                    Margin="10,0,0,0">

                    <StackPanel>

                        <TextBlock
                            Text="Activity Timeline"
                            FontSize="18"
                            Margin="0,0,0,10"/>

                        <TextBlock Text="10:31  - Alert Created"/>
                        <TextBlock Text="10:32  - Email Sent"/>
                        <TextBlock Text="10:34  - Assigned to DBA"/>
                        <TextBlock Text="10:35  - Acknowledged"/>
                        <TextBlock Text="10:36  - Investigation Started"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Grid>
</UserControl>
