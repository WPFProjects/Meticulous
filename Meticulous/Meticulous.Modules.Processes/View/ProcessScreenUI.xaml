<UserControl x:Class="Processes.View.ProcessScreenUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Processes.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>


        <TextBlock Text="Processes" 
                       Grid.Row="0"
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Center"/>
            <TextBlock Text="Last Updated: " 
                       Grid.Row="0"
                   FontSize="16" 
                   Margin="20,0,0,0"
                   HorizontalAlignment="Center"/>

        <StackPanel Orientation="Horizontal" 
                    Grid.Row="0"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center">
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Margin="0,0,10,0"/>
            <Button Content="Export"
                    Command="{Binding ExportProcessesCommand}"
                    Margin="0,0,10,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal">
            <TextBlock Text="Search Processes"/>
            <TextBlock Text="Search Filter"/>
            <ComboBox Text="Filters">
                <ComboBoxItem>Status</ComboBoxItem>
                <ComboBoxItem>Server</ComboBoxItem>
                <ComboBoxItem>CPU Usage</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Processes}"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                <DataGridTextColumn Header="Server" Binding="{Binding Server}"/>
                <DataGridTextColumn Header="CPU Usage" Binding="{Binding CPUUsage}"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <TextBlock Grid.Row="3" 
                   Text="{Binding SelectedProcessDetails}" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>
