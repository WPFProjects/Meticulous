<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    
                    xmlns:dashboardVm="clr-namespace:Meticulous.Modules.Dashboard.ViewModel;assembly=Meticulous.Modules.Dashboard"
                    xmlns:dashboardView="clr-namespace:Meticulous.Modules.Dashboard.View;assembly=Meticulous.Modules.Dashboard"
                    
                    xmlns:reportsVm="clr-namespace:Meticulous.Modules.Reports.ViewModel;assembly=Meticulous.Modules.Reports"
                    xmlns:reportsView="clr-namespace:Meticulous.Modules.Reports.View;assembly=Meticulous.Modules.Reports"
                    
                    xmlns:alertsVm="clr-namespace:Meticulous.Modules.Alerts.ViewModel;assembly=Meticulous.Modules.Alerts"
                    xmlns:alertsView="clr-namespace:Meticulous.Modules.Alerts.View;assembly=Meticulous.Modules.Alerts"
                    
                    xmlns:settingsVm="clr-namespace:Meticulous.Modules.Settings.ViewModel;assembly=Meticulous.Modules.Settings"
                    xmlns:settingsView="clr-namespace:Meticulous.Modules.Settings.View;assembly=Meticulous.Modules.Settings"
                    
                    xmlns:processVm="clr-namespace:Meticulous.Modules.Processes.ViewModel;assembly=Processes"
                    xmlns:processView="clr-namespace:Meticulous.Modules.Processes.View;assembly=Processes">
    
    
    <DataTemplate DataType="{x:Type dashboardVm:DashboardViewModel}">
        <dashboardView:DashboardUI/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type reportsVm:ReportsViewModel}">
        <reportsView:ReportUI/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type alertsVm:AlertsViewModel}">
        <alertsView:AlertsUI/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type settingsVm:SettingsViewModel}">
        <settingsView:SettingsUI/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type processVm:ProcessesViewModel}">
        <processView:ProcessScreenUI/>
    </DataTemplate>

</ResourceDictionary>