<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Brand -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryDarkColor">#1D4ED8</Color>
    <Color x:Key="AccentColor">#0EA5E9</Color>

    <!-- Background -->
    <Color x:Key="WindowBackgroundColor">#F5F7FA</Color>
    <Color x:Key="HeaderBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SidebarBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ToolbarBackgroundColor">#FAFAFA</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>

    <!-- Border -->
    <Color x:Key="BorderColor">#E5E7EB</Color>

    <!-- Text -->
    <Color x:Key="PrimaryTextColor">#111827</Color>
    <Color x:Key="SecondaryTextColor">#6B7280</Color>
    <Color x:Key="DisabledTextColor">#9CA3AF</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
</ResourceDictionary>