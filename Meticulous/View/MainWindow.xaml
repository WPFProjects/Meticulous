<Window x:Class="Meticulous.Shell.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Meticulous"
        xmlns:views="clr-namespace:Meticulous.View.Regions"
        mc:Ignorable="d"
        Title="Meticulous" 
        Height="450" 
        Width="800">
    
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <views:HeaderView x:Name="mainHeader"
                          Grid.Row="0"
                          Grid.ColumnSpan="2"/>

        <views:NavigationView x:Name="navigationView"
                              Grid.Row="1"
                              Grid.Column="0"
                              DataContext="{Binding Navigation}"/>

        <Grid Grid.Row="1"
              Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <views:ToolbarView x:Name="toolBarView"
                           Grid.Row="0"/>

            <views:ContentRegionView x:Name="contentRegionView"
                                 Grid.Row="1"
                                     DataContext="{Binding ContentRegion}"/>

        </Grid>

        <views:StatusBarView x:Name="statusBarView"
                             Grid.Row="2"
                             Grid.Column="0"
                             Grid.ColumnSpan="2"/>
    </Grid>
  
</Window>
